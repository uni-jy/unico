# Unico 环境变量示例（M1 用不到，留给后续里程碑）
PORT=8080

# LLM: DeepSeek / OpenAI-compatible chat completions
# 默认模型是 deepseek-v4-pro；如果你的中转模型名不同，在这里覆盖。
UNICO_MODEL=deepseek-v4-pro
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# 如果你用的是 OpenAI-compatible 中转，也可以改用：
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://your-relay.example/v1

# M2: NeteaseCloudMusicApi（建议本机起服务）
NCM_BASE=http://localhost:3000

# M4: Fish Audio TTS
FISH_API_KEY=
FISH_VOICE_ID=

# M5: 飞书 / OpenWeather / UPnP
LARK_APP_ID=
LARK_APP_SECRET=
OPENWEATHER_KEY=
UPNP_RENDERER_URL=
